---
import { SITE_TITLE } from '../consts';
---

<header>
	<a class="site-title" href="/">{SITE_TITLE}</a>
</header>
<style>
	header {
		width: 700px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 1em 0;
	}
	.site-title {
		font-family: var(--font-mono);
		font-size: 1.25em;
		font-weight: 700;
		color: rgb(var(--text-strong));
		text-decoration: none;
	}
	.site-title:hover {
		color: var(--accent);
	}
</style>
